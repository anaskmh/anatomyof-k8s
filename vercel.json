{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/topics/:topic",
      "destination": "/topics/:topic/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
