{
  "name": "cloudtruck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CloudTruck — Interactive visual explainers for Kubernetes, Docker, and modern DevOps systems",
  "author": "Anas Kadambalath",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node scripts/db/migrate.mjs",
