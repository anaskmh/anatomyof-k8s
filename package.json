    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "pdfjs-dist": "^6.3.289",
    "vite": "^5.4.10"
  }
}
